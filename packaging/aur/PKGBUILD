# Maintainer: Tjabooo <https://github.com/Tjabooo>
# Before publishing: run `updpkgsums` to replace SKIP with the real checksum.
pkgname=lagtrace
pkgver=0.1.0
pkgrel=1
pkgdesc="Click-to-photon latency for Linux games, measured in software (Vulkan layer, bench app, CLI)"
arch=('x86_64')
url="https://github.com/Tjabooo/lagtrace"
license=('MIT')
depends=('vulkan-icd-loader' 'sdl3' 'python')
makedepends=('vulkan-headers')
optdepends=('librsvg: PNG charts'
            'gamescope: the gamescope run in lagtrace suite'
            'vulkan-tools: lagtrace doctor checks for VK_EXT_present_timing')
install=lagtrace.install
source=("$pkgname-$pkgver.tar.gz::https://github.com/Tjabooo/lagtrace/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  make PREFIX=/usr
}

package() {
  cd "$pkgname-$pkgver"
  make install DESTDIR="$pkgdir" PREFIX=/usr
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
